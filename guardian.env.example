# FICTIONAL EXAMPLE ONLY. Replace these values in a private file outside Git.
# systemd EnvironmentFile syntax; no export or shell expansion.
TELEGRAM_BOT_TOKEN=000000000:EXAMPLE_ONLY_NOT_A_REAL_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_ALLOWED_USER_ID=123456789

# Required: replace with a destination exposed by your NUT server.
GUARDIAN_UPS_NAME=example-ups@localhost

# Optional. Exact values: true / false. Default: false (no socket access).
GUARDIAN_DOCKER_ENABLED=false

# Optional: expected mount points, not merely existing directories. Default: /.
GUARDIAN_IMPORTANT_MOUNTS=/

# Optional: observed outage threshold in whole seconds; NOT a NUT shutdown timer.
# Omit or leave empty to disable. No shutdown time is predicted.
# GUARDIAN_SHUTDOWN_WARNING_SECONDS=300
